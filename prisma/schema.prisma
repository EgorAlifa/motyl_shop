generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique // Название категории
  slug        String    @unique // URL-friendly идентификатор
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String           @db.Text
  price       Float
  stock       Int
  unit        String           @default("г") // грамм
  minOrder    Int              @default(50)  // минимальный заказ
  image       String?
  categoryId  String           // Foreign key
  category    ProductCategory  @relation(fields: [categoryId], references: [id])
  storage     String           @db.Text // условия хранения
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  orderItems  OrderItem[]

  @@index([categoryId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  deliveryAddress String  @db.Text
  deliveryDate    DateTime?
  comment         String?  @db.Text
  totalAmount     Float
  status          OrderStatus @default(NEW)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items       OrderItem[]
}

enum OrderStatus {
  NEW         // Новая заявка
  PROCESSING  // В обработке
  CONFIRMED   // Подтверждена
  SHIPPED     // Отправлена
  DELIVERED   // Доставлена
  CANCELLED   // Отменена
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Admin {
  id          String     @id @default(cuid())
  email       String     @unique
  password    String
  name        String
  role        AdminRole  @default(ADMIN)
  permissions String[]   // Массив прав: 'dashboard', 'products', 'orders', 'admins'
  isBlocked   Boolean    @default(false)
  lastLogin   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum AdminRole {
  SUPER_ADMIN  // Главный администратор (полный доступ)
  ADMIN        // Обычный администратор (ограниченный доступ)
}
