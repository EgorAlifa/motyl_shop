# Database
DATABASE_URL="postgresql://motyluser:motylpass@localhost:5432/motylshop"

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Admin Account (legacy - для первоначальной настройки)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Keycloak Configuration
# ВАЖНО: Для внутренних запросов используется http://keycloak:8080/auth
# Для внешнего доступа: https://ваш-домен/auth
KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=motyl-shop
KEYCLOAK_CLIENT_ID=motyl-admin
KEYCLOAK_CLIENT_SECRET=your-secure-client-secret-min-32-chars
KEYCLOAK_ADMIN_PASSWORD=your-secure-admin-password

# NextAuth / JWT Security
# ВАЖНО: Сгенерируйте случайный секрет командой: openssl rand -base64 32
NEXTAUTH_SECRET=your-very-secure-random-secret-key-min-32-chars
NEXTAUTH_URL=https://localhost:3000

# Domain for SSL certificate
DOMAIN=localhost
